{
  "id": "reading-metric-count",
"suite": "core",
  "page_plan": [
    {
      "alias": "reading",
      "source": "setup",
      "bind_chat": true,
      "create_mode": true
    }
  ],
  "agent_turns": 8,
  "steps": [
    {
      "id": "add-count",
      "kind": "prompt",
      "page": "reading",
      "chat": "reading-chat",
      "prompt": "add a count of done books at the top of this page, then check that it is right"
    }
  ],
  "setup": {
    "tools": [
      {
        "name": "list_books",
        "operation": "list",
        "collection": "books"
      }
    ],
    "records": [
      {
        "id": "b1",
        "collection": "books",
        "data": {
          "title": "A",
          "status": "done"
        }
      },
      {
        "id": "b2",
        "collection": "books",
        "data": {
          "title": "B",
          "status": "done"
        }
      },
      {
        "id": "b3",
        "collection": "books",
        "data": {
          "title": "C",
          "status": "reading"
        }
      }
    ],
    "initial_layout": {
      "blocks": [
        {
          "type": "list",
          "title": "Books",
          "collection": "books"
        }
      ]
    }
  },
  "checks": [
    {
      "id": "done-count",
      "type": "metric_count",
      "page": "reading",
      "value": {
        "collection": "books",
        "where": {
          "field": "status",
          "equals": "done"
        },
        "count": 2,
        "position": "first"
      }
    },
    {
      "id": "records-kept",
      "type": "records_exact",
      "page": "reading",
      "value": [
        {
          "title": "A",
          "status": "done"
        },
        {
          "title": "B",
          "status": "done"
        },
        {
          "title": "C",
          "status": "reading"
        }
      ]
    },
    {
      "id": "updated",
      "type": "successful_result",
      "page": "reading",
      "tool": "achilles__update_layout"
    },
    {
      "id": "inspected",
      "type": "successful_result",
      "page": "reading",
      "tool": "achilles__inspect_page"
    },
    {
      "id": "same-page",
      "type": "same_page",
      "page": "reading"
    }
  ],
  "requires": [
    "update_layout"
  ]
}
