{
  "id": "reading-list-one-prompt",
  "prompt": "make a page that tracks my reading list",
  "page_plan": [
    {
      "alias": "home",
      "source": "fixture",
      "bind_chat": true,
      "create_mode": true
    },
    {
      "alias": "reading",
      "source": "created",
      "bind_chat": false,
      "create_mode": false,
      "route": "/reading-list"
    }
  ],
  "agent_turns": 20,
  "steps": [
    {
      "id": "creation-prompt",
      "kind": "prompt",
      "page": "home",
      "chat": "home-chat",
      "prompt": "create /reading-list titled Reading List with a list block for the books collection and tools add_book (insert), update_book (update), and list_books (list) for that collection"
    }
  ],
  "checks": [
    {
      "id": "page",
      "type": "page_exists",
      "page": "reading",
      "route": "/reading-list"
    },
    {
      "id": "add_book",
      "type": "tool",
      "page": "reading",
      "name": "add_book"
    },
    {
      "id": "update_book",
      "type": "tool",
      "page": "reading",
      "name": "update_book"
    },
    {
      "id": "list_books",
      "type": "tool",
      "page": "reading",
      "name": "list_books"
    },
    {
      "id": "list-layout",
      "type": "layout_contains",
      "page": "reading",
      "value": {
        "type": "list"
      }
    },
    {
      "id": "visible-title",
      "type": "browser_text",
      "page": "reading",
      "text": "Reading List"
    },
    {
      "id": "same-page",
      "type": "same_page",
      "page": "reading"
    }
  ]
}
