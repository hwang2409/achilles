{
  "id": "judge-page-and-annotate",
  "page_plan": [
    {
      "alias": "home",
      "source": "fixture",
      "bind_chat": true,
      "create_mode": true
    },
    {
      "alias": "review",
      "source": "created",
      "bind_chat": true,
      "create_mode": true,
      "route": "/run-review"
    }
  ],
  "agent_turns": 12,
  "steps": [
    {
      "id": "create-review",
      "kind": "prompt",
      "page": "home",
      "chat": "home-chat",
      "prompt": "create /run-review titled Run Review with a list block for the annotations collection and a detail block for record_id run-002"
    },
    {
      "id": "annotate",
      "kind": "annotate",
      "page": "review",
      "chat": "review-chat",
      "prompt": "create add_annotation and list_annotations tools on this page, then use add_annotation to record run_id run-002 with verdict bad and list the annotations"
    }
  ],
  "checks": [
    {
      "id": "page",
      "type": "page_exists",
      "page": "review",
      "route": "/run-review"
    },
    {
      "id": "add-tool",
      "type": "tool",
      "page": "review",
      "name": "add_annotation"
    },
    {
      "id": "list-tool",
      "type": "tool",
      "page": "review",
      "name": "list_annotations"
    },
    {
      "id": "annotation",
      "type": "record",
      "page": "review",
      "value": {
        "run_id": "run-002",
        "verdict": "bad"
      }
    },
    {
      "id": "add-result",
      "type": "successful_result",
      "page": "review",
      "tool": "achilles__add_annotation",
      "value": {
        "run_id": "run-002",
        "verdict": "bad"
      }
    },
    {
      "id": "list-layout",
      "type": "layout_contains",
      "page": "review",
      "value": {
        "type": "list"
      }
    },
    {
      "id": "detail-layout",
      "type": "layout_contains",
      "page": "review",
      "value": {
        "type": "detail"
      }
    },
    {
      "id": "same-page",
      "type": "same_page",
      "page": "review"
    }
  ],
  "goal_capabilities": [
    "update_layout"
  ]
}
