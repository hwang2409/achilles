{
  "id": "long-chain-inventory",
  "suite": "hard",
  "page_plan": [
    {
      "alias": "home",
      "source": "fixture",
      "bind_chat": true,
      "create_mode": true
    },
    {
      "alias": "inventory",
      "source": "created",
      "route": "/inventory",
      "bind_chat": false,
      "create_mode": false
    }
  ],
  "agent_turns": 20,
  "steps": [
    {
      "id": "build",
      "kind": "prompt",
      "page": "home",
      "chat": "home-chat",
      "prompt": "make a page at /inventory titled Inventory with three tools: add_item (name, location, and quantity as an integer), list_items, and update_item, plus a list block that shows name, location and quantity"
    },
    {
      "id": "stock",
      "kind": "prompt",
      "page": "inventory",
      "chat": "inventory-chat",
      "prompt": "add these items, one record each: Bolts in Basement with quantity 3, Nails in Basement with quantity 12, Screws in Basement with quantity 4, Hinges in Garage with quantity 2, Brackets in Garage with quantity 9, Washers in Basement with quantity 1, Clamps in Garage with quantity 15, Rope in Shed with quantity 6, Tarp in Shed with quantity 3, Gloves in Shed with quantity 20. then set quantity to 25 on every Basement item whose quantity is under 5. then tell me how many items each location has and which items you restocked"
    }
  ],
  "checks": [
    {
      "id": "page",
      "type": "page_exists",
      "page": "inventory"
    },
    {
      "id": "items",
      "type": "records_exact",
      "page": "inventory",
      "value": [
        {
          "name": "Bolts",
          "location": "Basement",
          "quantity": 25
        },
        {
          "name": "Nails",
          "location": "Basement",
          "quantity": 12
        },
        {
          "name": "Screws",
          "location": "Basement",
          "quantity": 25
        },
        {
          "name": "Hinges",
          "location": "Garage",
          "quantity": 2
        },
        {
          "name": "Brackets",
          "location": "Garage",
          "quantity": 9
        },
        {
          "name": "Washers",
          "location": "Basement",
          "quantity": 25
        },
        {
          "name": "Clamps",
          "location": "Garage",
          "quantity": 15
        },
        {
          "name": "Rope",
          "location": "Shed",
          "quantity": 6
        },
        {
          "name": "Tarp",
          "location": "Shed",
          "quantity": 3
        },
        {
          "name": "Gloves",
          "location": "Shed",
          "quantity": 20
        }
      ]
    },
    {
      "id": "no-double-insert",
      "type": "no_duplicate_writes",
      "page": "inventory",
      "tool": "achilles__add_item"
    },
    {
      "id": "no-double-update",
      "type": "no_duplicate_writes",
      "page": "inventory",
      "tool": "achilles__update_item"
    }
  ]
}
