{
  "id": "duplicate-prompt-recovery",
  "page_plan": [
    {
      "alias": "existing",
      "source": "fixture",
      "bind_chat": true,
      "create_mode": false
    }
  ],
  "agent_turns": 10,
  "steps": [
    {
      "id": "reuse",
      "kind": "prompt",
      "page": "existing",
      "chat": "existing-chat",
      "prompt": "this notes page may already exist; use list_notes to read the existing note without creating duplicates"
    }
  ],
  "setup": {
    "tools": [
      {
        "name": "list_notes",
        "operation": "list",
        "collection": "notes"
      }
    ],
    "records": [
      {
        "id": "seeded-note",
        "collection": "notes",
        "data": {
          "text": "seeded note"
        }
      }
    ]
  },
  "checks": [
    {
      "id": "one-page",
      "type": "count",
      "page": "existing",
      "name": "pages",
      "count": 1
    },
    {
      "id": "one-tool",
      "type": "count",
      "page": "existing",
      "name": "tools",
      "count": 1
    },
    {
      "id": "use",
      "type": "successful_result",
      "page": "existing",
      "tool": "achilles__list_notes"
    },
    {
      "id": "same-page",
      "type": "same_page",
      "page": "existing"
    }
  ]
}
