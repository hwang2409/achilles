      "page": "home",
      "chat": "home-chat",
      "prompt": "build two linked pages. /projects keeps the projects collection, with tools add_project (fields id and name) and list_projects, a list block of projects, and a detail block that shows the project whose id is apollo. /tasks keeps the tasks collection, with tools add_task (fields title, project_id, status) and list_tasks, where project_id holds a project's id. on /tasks put first a metric block that counts tasks whose project_id is apollo, then a list block of tasks with fields title, status, project_id in that order"
    },
    {
      "id": "add-projects",
      "kind": "prompt",
      "page": "projects",
      "chat": "projects-chat",
      "prompt": "add two projects: id apollo named Apollo, and id zephyr named Zephyr"
    },
    {
      "id": "add-tasks",
      "kind": "prompt",
      "page": "tasks",
      "chat": "tasks-chat",
      "prompt": "add three tasks: write spec for project apollo with status open, ship v1 for project apollo with status done, and pick logo for project zephyr with status open. then check this page's metric"
    }
