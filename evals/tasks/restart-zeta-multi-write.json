  "agent_turns": 14,
  "approval_mode": "ask",
  "steps": [
    {
      "id": "write",
      "kind": "prompt",
      "page": "contacts",
      "chat": "contacts-chat",
      "prompt": "add these 5 contacts with add_contact, one call per contact, using the fields name and email: Ada Lovelace (ada@example.test), Grace Hopper (grace@example.test), Alan Turing (alan@example.test), Katherine Johnson (katherine@example.test), Edsger Dijkstra (edsger@example.test). then tell me how many contacts you added.",
