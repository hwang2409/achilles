        "tool": "achilles__add_contact",
        "nth": 3,
        "restart_zeta": true
      }
    },
    {
      "id": "resume",
      "kind": "prompt",
      "page": "contacts",
      "chat": "contacts-chat",
      "prompt": "continue"
    }
  ],
  "setup": {
