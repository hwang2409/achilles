{
  "id": "build-workout-log",
  "prompt": "make a workout log page, starting empty. each workout has an exercise name and a whole number of reps. show the workouts in a list, newest first, and a form to log a workout.",
  "page_plan": [
    {
      "alias": "home",
      "source": "fixture",
      "bind_chat": true,
      "create_mode": true
    },
    {
      "alias": "workouts",
      "source": "created",
      "bind_chat": false,
      "create_mode": false
    }
  ],
  "agent_turns": 12,
  "steps": [
    {
      "id": "build",
      "kind": "prompt",
      "page": "home",
      "chat": "home-chat"
    },
    {
      "id": "add-one",
      "kind": "prompt",
      "page": "workouts",
      "chat": "workouts-chat",
      "prompt": "use this page's tools to log one workout: exercise Synthetic Squats, 12 reps"
    }
  ],
  "checks": [
    {
      "id": "page",
      "type": "page_exists",
      "page": "workouts"
    },
    {
      "id": "one-record",
      "type": "count",
      "page": "workouts",
      "name": "records",
      "count": 1
    },
    {
      "id": "record",
      "type": "schema_roundtrip",
      "page": "workouts",
      "value": [
        "Synthetic Squats"
      ]
    },
    {
      "id": "number-stored",
      "type": "record",
      "page": "workouts",
      "value": {
        "reps": 12
      }
    },
    {
      "id": "list",
      "type": "list_shows",
      "page": "workouts",
      "value": "Synthetic Squats"
    },
    {
      "id": "form-submit",
      "type": "form_submit",
      "page": "workouts",
      "value": {
        "string": "Form Squats",
        "integer": "10",
        "number": "10"
      }
    },
    {
      "id": "page-tools-only",
      "type": "assigned_tools_only",
      "page": "workouts"
    },
    {
      "id": "same-page",
      "type": "same_page",
      "page": "workouts"
    }
  ],
  "goal_capabilities": [
    "create_page_with_tools"
  ]
}
